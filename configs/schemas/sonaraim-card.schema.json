{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonaraim.org/schemas/sonaraim-card.schema.json",
  "title": "SonaraimCard",
  "description": "Declarative, XSS-free rich B2B card schema with mandatory DID Ed25519 merchant signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "title",
    "summary",
    "components",
    "merchant_signature"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_type", "label"],
        "properties": {
          "component_type": {
            "type": "string",
            "enum": [
              "text_block",
              "media_image",
              "key_value_row",
              "action_button"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "value": {
            "type": "string",
            "maxLength": 500
          },
          "action_uri": {
            "type": "string",
            "pattern": "^(https://|sonaraim://)[^\\s<>\"']+$"
          }
        }
      }
    },
    "merchant_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["did", "algorithm", "signature_hex"],
      "properties": {
        "did": {
          "type": "string",
          "pattern": "^did:(web|sonaraim):[A-Za-z0-9._:-]+$"
        },
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "signature_hex": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{128}$"
        }
      }
    }
  }
}
